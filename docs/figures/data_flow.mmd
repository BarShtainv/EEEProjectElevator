flowchart LR
    NOTE["PROPOSED PROJECT DATA FLOW<br/>software-only; no physical elevator command"]
    REQ["Source + complete frame + floor"]
    BUSY{"Output active?"}
    VAL["Validate source / frame / parity<br/>and decode"]
    LOOK["Composite credential lookup"]
    AUTH["Enabled + floor + mask decision"]
    PRELOG["Append canonical result event"]
    ACT["Activate one output + expiry"]
    DENY["Denial / validation result<br/>no new activation"]
    LOGERR["Explicit logging_error<br/>grant withheld"]
    CLOCK["Simulated clock"]
    RESET["Manual / watchdog reset<br/>interrupts any flow"]
    OBS["Harness observes state and faults"]
    END["Abstract permission state only"]

    REQ --> BUSY
    BUSY -- yes --> DENY
    BUSY -- no --> VAL
    VAL -- invalid --> DENY
    VAL -- valid --> LOOK
    LOOK -- unknown/disabled --> DENY
    LOOK -- record --> AUTH
    AUTH -- deny/error --> DENY
    AUTH -- grant candidate --> PRELOG
    PRELOG -- append succeeds --> ACT --> END
    PRELOG -- append fails --> LOGERR
    DENY --> PRELOG
    CLOCK --> ACT
    CLOCK --> RESET
    RESET --> END
    ACT --> OBS
    DENY --> OBS
    LOGERR --> OBS
    NOTE --- END

