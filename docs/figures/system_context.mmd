flowchart LR

    subgraph PB["PROJECT BOUNDARY — deterministic software model only"]
        direction TB

        subgraph INPUTS["LOGICAL INPUTS"]
            direction LR
            LF["LF source label"]
            HF["HF source label"]
            FLOOR["Floor request<br/>1–16"]
            HARNESS["Test harness<br/>time + fault injection"]
        end

        subgraph MODEL["REFERENCE MODEL"]
            direction LR
            MSG["Complete credential frame<br/>PROJECT_WIEGAND_26"]
            DB[("Credential repository<br/>composite key + 16-bit mask")]
            CTRL["Controller<br/>validate · look up · authorize<br/>time · log · reset · watchdog"]
            OUT["16 Boolean<br/>permission outputs"]
            LOG[("Structured<br/>event log")]
        end

        LF --> MSG
        HF --> MSG
        MSG --> CTRL
        FLOOR --> CTRL
        HARNESS --> CTRL
        HARNESS --> DB
        CTRL <--> DB
        CTRL --> OUT
        CTRL --> LOG
        OUT --> HARNESS
        LOG --> HARNESS
    end

    subgraph EX["OUTSIDE PROJECT BOUNDARY"]
        direction TB
        COMM["Commercial controller<br/>internals and equivalence"]
        RFID["RFID readers, tags,<br/>RF propagation and electronics"]
        ELEV["Elevator controller<br/>and electrical wiring"]
        SAFETY["Motion · doors · brakes<br/>passenger-safety systems"]
    end

    COMM -. "not modeled; no equivalence claimed" .- CTRL
    RFID -. "logical source labels only" .- LF
    RFID -. "logical source labels only" .- HF
    ELEV -. "no electrical or physical interface" .- OUT
    SAFETY -. "no control, installation, or certification claim" .- OUT

    classDef outside fill:#f5f5f5,stroke:#777,stroke-dasharray:5 5,color:#333;
    classDef boundary fill:#eef6ff,stroke:#1f5f99,color:#111;
    class COMM,RFID,ELEV,SAFETY outside;
    class LF,HF,MSG,FLOOR,HARNESS,CTRL,DB,OUT,LOG boundary;
